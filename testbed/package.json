{
  "name": "realtime-sports-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node subgraphs/server.mjs",
    "compose-schema": "node scripts/compose.mjs",
    "gateway": "hive-gateway supergraph gateway/supergraph.graphql -c gateway/gateway.config.mjs",
    "edge": "node emulator/edge.mjs",
    "client": "node client/main.mjs",
    "demo": "node scripts/demo.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 tests/*.test.mjs",
    "test:router": "GRAPHQL_URL=${GRAPHQL_URL:-http://localhost:4100/graphql} node scripts/verify.mjs",
    "test:router-scale": "node scripts/verify-router-scale.mjs",
    "test:router-harness": "node scripts/router-harness.mjs",
    "test:router-real": "node scripts/router-real.mjs"
  },
  "dependencies": {
    "@apollo/composition": "^2.12.0",
    "@apollo/subgraph": "^2.12.0",
    "@graphql-hive/gateway": "^2.15.2",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "ws": "^8.18.3"
  }
}
